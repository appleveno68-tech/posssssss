<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Salah POS Pro - نظام المطاعم المتقدم والمحاسبة</title>
<style>
:root{--bg:#12161f;--card:#1c2331;--panel:#171f2d;--text:#f0f2f5;--muted:#9aa4b2;--line:#2a3447;--primary:#3b82f6;--danger:#ef4444;--ok:#10b981;--warn:#f59e0b;--dark:#0b0f17}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Tahoma,Arial,sans-serif;user-select:none}
button,input,select,textarea{font:inherit}button{border:0;border-radius:8px;padding:10px 14px;cursor:pointer;font-weight:600}
.app{display:flex;min-height:100vh}.side{width:220px;background:var(--dark);color:#fff;padding:16px;display:flex;flex-direction:column;justify-content:space-between;border-left:1px solid var(--line)}
.brand{font-weight:800;font-size:20px;margin-bottom:24px;color:#fff}.brand span{display:block;color:var(--muted);font-size:11px;margin-top:2px}
.nav{display:flex;flex-direction:column;gap:6px}.nav button{width:100%;background:transparent;color:var(--muted);text-align:right;padding:11px;border-radius:8px;transition:0.2s}
.nav button:hover,.nav .on{background:var(--primary);color:#fff}
.main{flex:1;padding:16px;display:flex;flex-direction:column;height:100vh;overflow:hidden}
.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--line)}
.top h1{margin:0;font-size:20px}.actions{display:flex;gap:8px}

.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.grid2{display:grid;grid-template-columns:1.2fr .8fr;gap:12px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.field{margin-bottom:8px}.field label{display:block;font-size:11px;color:var(--muted);margin-bottom:4px}input,select,textarea{width:100%;border:1px solid var(--line);border-radius:8px;padding:10px;background:var(--panel);color:#fff;outline:none}input:focus,select:focus{border-color:var(--primary)}
.primary{background:var(--primary);color:#fff}.secondary{background:#2a3447;color:#fff}.danger{background:var(--danger);color:#fff}.ok{background:var(--ok);color:#fff}.warn{background:var(--warn);color:#000}
.stat .label{font-size:12px;color:var(--muted)}.stat .num{font-size:24px;font-weight:900;margin-top:5px}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:8px}table{width:100%;border-collapse:collapse}th,td{padding:10px;border-bottom:1px solid var(--line);text-align:right;font-size:12px}th{background:var(--panel);color:var(--muted)}
.badge{display:inline-block;padding:3px 8px;border-radius:999px;font-size:10px;background:var(--panel);color:var(--primary)}
.empty{text-align:center;padding:30px;color:var(--muted)}
.row{display:flex;gap:8px;align-items:end;flex-wrap:wrap}.row>*{flex:1;min-width:120px}

.foodics-pos{display:grid;grid-template-columns:1fr 380px;gap:12px;height:calc(100vh - 80px);overflow:hidden}
.pos-left{display:flex;flex-direction:column;gap:10px;overflow:hidden}
.categories-bar{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px}
.cat-btn{background:var(--panel);color:var(--muted);border:1px solid var(--line);padding:8px 16px;border-radius:8px;white-space:nowrap;font-size:13px}
.cat-btn.active,.cat-btn:hover{background:var(--primary);color:#fff;border-color:var(--primary)}
.pos-products{display:grid;grid-template-columns:repeat(auto-fill, minmax(130px, 1fr));gap:10px;overflow-y:auto;padding:2px}
.foodics-product{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px;text-align:center;cursor:pointer;transition:0.15s;display:flex;flex-direction:column;justify-content:space-between;min-height:100px}
.foodics-product:hover{border-color:var(--primary);transform:translateY(-2px)}
.foodics-product b{font-size:13px;display:block;margin-bottom:6px}
.foodics-product .price{color:var(--ok);font-weight:bold;font-size:13px}

.pos-right{background:var(--card);border:1px solid var(--line);border-radius:12px;display:flex;flex-direction:column;overflow:hidden}
.cart-header{padding:12px;border-bottom:1px solid var(--line);font-weight:bold;display:flex;justify-content:space-between;align-items:center}
.cart-items{flex:1;overflow-y:auto;padding:10px}
.cart-line{display:grid;grid-template-columns:1fr 70px 80px 24px;gap:6px;align-items:center;padding:8px 0;border-bottom:1px dashed var(--line);font-size:12px}
.cart-line input{padding:4px;text-align:center}
.cart-footer{padding:12px;border-top:1px solid var(--line);background:var(--panel)}
.kpi-row{display:flex;justify-content:space-between;margin-bottom:6px;font-size:13px}

.overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:1000;display:flex;align-items:center;justify-content:center;padding:15px}
.modal{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px;width:min(900px,100%);max-height:90vh;overflow:auto}
.toast{position:fixed;left:18px;bottom:18px;background:#10b981;color:#fff;padding:10px 16px;border-radius:8px;opacity:0;pointer-events:none;transition:.2s;z-index:2000;font-weight:bold}
.toast.show{opacity:1}

.tables-grid{display:grid;grid-template-columns:repeat(auto-fill, minmax(140px, 1fr));gap:12px;overflow-y:auto;padding:4px}
.table-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px;text-align:center;cursor:pointer;transition:0.2s}
.table-card:hover{border-color:var(--primary)}
.table-card.busy{border-color:var(--warn);background:rgba(245, 158, 11, 0.05)}
.kds-grid{display:grid;grid-template-columns:repeat(auto-fill, minmax(280px, 1fr));gap:14px;overflow-y:auto;padding:4px}
.kds-card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px;display:flex;flex-direction:column;gap:8px;border:2px solid var(--warn);animation:pulseBorder 1.5s infinite}
@keyframes pulseBorder{0%{border-color:var(--warn)} 50%{border-color:transparent} 100%{border-color:var(--warn)}}
</style>
</head>
<body>
<div id="root"></div><div id="toast" class="toast"></div>

<script>
const DBKEY='salah_pos_pro_v5';
const defaultData = {
  setup: false,
  business: { name: '', activity: 'مطعم ومأكولات', vat: '', cr: '', phone: '', address: '', city: '', branch: 'الفرع الرئيسي', vatRate: 15, cashier: '', invoiceStart: 1001 },
  settings: { lowStock: 5, currency: 'ر.س' },
  products: [],
  sales: [],
  expenses: [], // المصروفات
  deliveries: [], // مبالغ وتسويات تطبيقات التوصيل
  tables: [
    { id: 't1', name: 'طاولة 1', status: 'empty', order: null },
    { id: 't2', name: 'طاولة 2', status: 'empty', order: null },
    { id: 't3', name: 'طاولة 3', status: 'empty', order: null },
    { id: 't4', name: 'VIP 1', status: 'empty', order: null }
  ],
  kds: [], // طلبات المطبخ المعلقة
  lastInvoice: 1000
};

let db = defaultData;
function loadDB() {
  try {
    const saved = localStorage.getItem(DBKEY);
    if (saved) db = JSON.parse(saved);
  } catch (e) { db = defaultData; }
}
loadDB();

// مزامنة فورية ولحظية عبر التخزين والأجهزة المفتوحة على نفس المتصفح/الشبكة المحلية
window.addEventListener('storage', (e) => {
  if (e.key === DBKEY) {
    let oldKdsLen = db.kds.length;
    loadDB();
    // إذا ظهر طلب جديد في المطبخ ولم يتم قبوله، نشغل صفارة الإنذار الصاخبة
    if (db.kds.length > 0 && page === 'kds') {
      triggerAlarm();
    }
    render();
  }
});

let page = 'pos', cart = [], currentCat = 'الكل', selectedPay = 'نقدي', orderType = 'محلي', activeTable = null, deliveryApp = 'جاهز';
let deliveryOrderNo = '', deliveryCaptain = '';
let alarmInterval = null;

const $ = id => document.getElementById(id);
const save = () => { localStorage.setItem(DBKEY, JSON.stringify(db)); };
const uid = () => Date.now().toString(36) + Math.random().toString(36).substr(2);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const money = n => Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + (db.settings?.currency || 'ر.س');
const toast = t => { let x = $('toast'); if (!x) return; x.textContent = t; x.classList.add('show'); setTimeout(() => x.classList.remove('show'), 2200); };
const sum = (a, f) => a.reduce((n, x) => n + (Number(f(x)) || 0), 0);

// نظام التنبيه الصوتي العالي والمتكرر للمطبخ
function triggerAlarm() {
  if (alarmInterval) return; // شغالة بالفعل
  playBeep();
  alarmInterval = setInterval(() => {
    if (db.kds.length === 0) {
      stopAlarm();
    } else {
      playBeep();
    }
  }, 3000); // تكرار كل 3 ثواني حتى يتم قبول الطلب
}

function stopAlarm() {
  if (alarmInterval) {
    clearInterval(alarmInterval);
    alarmInterval = null;
  }
}

function playBeep() {
  try {
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'square';
    osc.frequency.setValueAtTime(880, audioCtx.currentTime); // صوت حاد ومرتفع
    gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + 0.8);
  } catch(e) {}
}

function navBtn(id, t) { return `<button class="${page === id ? 'on' : ''}" onclick="page='${id}';render()">${t}</button>`; }
function side() {
  let badgeKds = db.kds.length ? ` <span style="background:var(--danger);padding:1px 6px;border-radius:99px;font-size:10px">${db.kds.length}</span>` : '';
  return `<aside class="side"><div class="brand">Salah POS<span>نظام المطاعم المتطور</span></div><div class="nav">
  ${navBtn('pos', '⚡ نقطة البيع')}${navBtn('tables', '🍽️ الصالات والطاولات')}${navBtn('kds', '👨‍🍳 شاشة المطبخ (KDS)' + badgeKds)}
  ${navBtn('accounts', '💰 الحسابات والمالية')}${navBtn('deliveries', '🛵 تسويات التوصيل')}${navBtn('dashboard', '📊 التقارير والأرباح')}
  ${navBtn('sales', '🧾 الفواتير')}${navBtn('products', '📦 المنتجات')}${navBtn('settings', '⚙️ الإعدادات')}
  </div><div style="font-size:10px;color:var(--muted);text-align:center">إدارة المهندس صلاح علي</div></aside>`;
}
function shell(content, title) {
  return `<div class="app">${side()}<main class="main"><div class="top"><div><h1>${title}</h1><div style="font-size:11px;color:var(--muted)">${esc(db.business.name)} — ${esc(db.business.branch)}</div></div><div class="actions"><button class="secondary" onclick="resetCart();page='pos';render()">+ سلة جديدة</button><button class="secondary" onclick="page='settings';render()">إعدادات</button></div></div>${content}</main></div>`;
}

function setup() {
  return `<div class="overlay"><div class="modal" style="max-width:800px"><h2>إعداد النظام المحاسبي للمطاعم</h2><p style="color:var(--muted);font-size:12px">أدخل بيانات المطعم للبدء.</p>
  <div class="grid3">
  ${field('n', 'اسم المطعم *', db.business.name)}${field('a', 'النشاط', db.business.activity)}${field('v', 'الرقم الضريبي VAT *', db.business.vat)}
  ${field('cr', 'السجل التجاري', db.business.cr)}${field('ph', 'الهاتف', db.business.phone)}${field('ad', 'العنوان', db.business.address)}
  ${field('ci', 'المدينة', db.business.city)}${field('br', 'الفرع', db.business.branch)}${field('rate', 'VAT %', db.business.vatRate, 'number')}
  ${field('start', 'رقم أول فاتورة', db.business.invoiceStart, 'number')}${field('cash', 'اسم الكاشير', db.business.cashier)}
  </div><button class="primary" style="margin-top:14px;width:100%" onclick="finishSetup()">حفظ والانتقال للنظام</button></div></div>`;
}
function field(id, label, val, type = 'text') { return `<div class="field"><label>${label}</label><input id="b_${id}" type="${type}" value="${esc(val)}"></div>`; }
function finishSetup() {
  const v = id => ($('b_' + id) || {}).value || '';
  if (!v('n') || !v('v')) return toast('الاسم والرقم الضريبي مطلوبان');
  db.business = { ...db.business, name: v('n'), activity: v('a'), vat: v('v'), cr: v('cr'), phone: v('ph'), address: v('ad'), city: v('ci'), branch: v('br') || 'الفرع الرئيسي', vatRate: Number(v('rate') || 15), cashier: v('cash'), invoiceStart: Number(v('start') || 1001) };
  db.lastInvoice = db.business.invoiceStart - 1; db.setup = true; save(); render();
}

// ----------------- الطاولات -----------------
function tablesPage() {
  return shell(`<div class="card" style="flex:1;display:flex;flex-direction:column;overflow:hidden">
    <div class="row" style="margin-bottom:10px">
      <button class="primary" onclick="addTablePrompt()">+ إضافة طاولة جديدة</button>
      <span style="color:var(--muted);font-size:12px;align-self:center">اختر طاولة لفتح أو استعراض طلبها الحالي</span>
    </div>
    <div class="tables-grid">
      ${db.tables.map(t => `<div class="table-card ${t.status === 'busy' ? 'busy' : ''}" onclick="openTable('${t.id}')">
        <div style="font-size:18px;font-weight:bold;margin-bottom:6px">${esc(t.name)}</div>
        <div class="badge">${t.status === 'busy' ? 'مشغولة (' + (t.order?.items?.length || 0) + ' أصناف)' : 'فارغة'}</div>
      </div>`).join('')}
    </div>
  </div>`, 'إدارة الصالات والطاولات');
}

function addTablePrompt() {
  let name = prompt('أدخل اسم أو رقم الطاولة الجديدة (مثلاً: طاولة 5):');
  if (!name) return;
  db.tables.push({ id: uid(), name: name.trim(), status: 'empty', order: null });
  save(); render(); toast('تمت إضافة الطاولة');
}

function openTable(id) {
  let t = db.tables.find(x => x.id === id);
  if (!t) return;
  activeTable = t;
  orderType = 'محلي';
  cart = (t.status === 'busy' && t.order) ? [...t.order.items] : [];
  page = 'pos';
  render();
}

// ----------------- الكاشير -----------------
function posPage() {
  let categories = ['الكل', ...new Set(db.products.map(p => p.category || 'وجبات'))];
  let filteredProducts = currentCat === 'الكل' ? db.products : db.products.filter(p => (p.category || 'وجبات') === currentCat);
  let q = window._posQ || '';
  if (q) filteredProducts = filteredProducts.filter(p => p.name.toLowerCase().includes(q.toLowerCase()) || (p.barcode && p.barcode.includes(q)));

  let tableTitle = activeTable ? `📍 الطاولة الحالية: ${activeTable.name}` : '⚡ طلب عام (بدون طاولة)';

  return shell(`<div class="foodics-pos">
    <div class="pos-left">
      <div style="background:var(--card);border:1px solid var(--line);padding:8px 12px;border-radius:8px;display:flex;justify-content:space-between;align-items:center">
        <b>${tableTitle}</b>
        <div style="display:flex;gap:4px">
          <button class="${orderType === 'محلي' ? 'ok' : 'secondary'}" style="padding:4px 10px;font-size:11px" onclick="orderType='محلي';activeTable=null;render()">محلي</button>
          <button class="${orderType === 'سفري' ? 'ok' : 'secondary'}" style="padding:4px 10px;font-size:11px" onclick="orderType='سفري';activeTable=null;render()">سفري</button>
          <button class="${orderType === 'توصيل' ? 'ok' : 'secondary'}" style="padding:4px 10px;font-size:11px" onclick="orderType='توصيل';activeTable=null;render()">توصيل تطبيقات</button>
        </div>
      </div>
      ${orderType === 'توصيل' ? `<div style="display:flex;flex-direction:column;gap:6px;background:var(--card);padding:10px;border-radius:8px;border:1px solid var(--line)">
        <div style="display:flex;gap:6px">
          <span style="font-size:11px;color:var(--muted);align-self:center">المنصة:</span>
          <button class="${deliveryApp === 'جاهز' ? 'primary' : 'secondary'}" style="padding:4px 10px;font-size:11px" onclick="deliveryApp='جاهز';render()">جاهز (Jahez)</button>
          <button class="${deliveryApp === 'هنقرستيشن' ? 'primary' : 'secondary'}" style="padding:4px 10px;font-size:11px" onclick="deliveryApp='هنقرستيشن';render()">هنقرستيشن</button>
          <button class="${deliveryApp === 'تويو' ? 'primary' : 'secondary'}" style="padding:4px 10px;font-size:11px" onclick="deliveryApp='تويو';render()">تويو (ToYou)</button>
          <button class="${deliveryApp === 'مرسول' ? 'primary' : 'secondary'}" style="padding:4px 10px;font-size:11px" onclick="deliveryApp='مرسول';render()">مرسول</button>
        </div>
        <div style="display:flex;gap:8px">
          <input id="delOrderNo" placeholder="رقم طلب المنصة (مثال: #8592)" value="${esc(deliveryOrderNo)}" oninput="deliveryOrderNo=this.value" style="font-size:12px;padding:6px">
          <input id="delCaptain" placeholder="اسم أو رقم المندوب / الكابتن" value="${esc(deliveryCaptain)}" oninput="deliveryCaptain=this.value" style="font-size:12px;padding:6px">
        </div>
      </div>` : ''}
      <div class="row" style="margin-bottom:0">
        <input id="posSearch" placeholder="بحث سريع عن وجبة أو مشروب..." oninput="window._posQ=this.value;render()" value="${esc(q)}" autofocus>
      </div>
      <div class="categories-bar">
        ${categories.map(c => `<button class="cat-btn ${currentCat === c ? 'active' : ''}" onclick="currentCat='${c}';render()">${c}</button>`).join('')}
      </div>
      <div class="pos-products">
        ${filteredProducts.length ? filteredProducts.map(p => `<div class="foodics-product" onclick="addCart('${p.id}')"><div><b>${esc(p.name)}</b><div style="font-size:10px;color:var(--muted)">مخزون: ${p.stock}</div></div><div class="price">${money(p.price)}</div></div>`).join('') : '<div class="empty" style="grid-column:1/-1">لا توجد منتجات مطابقة</div>'}
      </div>
    </div>
    <div class="pos-right">
      <div class="cart-header"><span>سلة الطلب الحالي</span><button class="danger" style="padding:4px 8px;font-size:11px" onclick="resetCart();render()">إفراغ</button></div>
      <div class="cart-items">
        ${cart.length ? cart.map((x, i) => { let p = db.products.find(y => y.id === x.id); if (!p) return ''; return `<div class="cart-line"><div><b>${esc(p.name)}</b><div style="color:var(--muted);font-size:10px">${money(p.price)}</div></div><input type="number" min="1" value="${x.qty}" onchange="setQty('${x.id}',this.value)"><div>${money(p.price * x.qty)}</div><button class="danger" style="padding:2px 6px" onclick="cart.splice(${i},1);render()">×</button></div>`; }).join('') : '<div class="empty">السلة فارغة</div>'}
      </div>
      ${cart.length ? cartTotals() : ''}
    </div>
  </div>`, 'نقطة البيع (الكاشير والمطاعم)');
}

function cartTotals() {
  let net = sum(cart, x => { let p = db.products.find(y => y.id === x.id); return p ? (p.price * x.qty) : 0; });
  let vat = net * db.business.vatRate / 100, total = net + vat;
  return `<div class="cart-footer">
    <div class="kpi-row"><span style="color:var(--muted)">المجموع قبل الضريبة</span><b>${money(net)}</b></div>
    <div class="kpi-row"><span style="color:var(--muted)">الضريبة (${db.business.vatRate}%)</span><b>${money(vat)}</b></div>
    <div class="kpi-row" style="font-size:16px;margin-top:6px"><span>الإجمالي المستحق</span><b style="color:var(--ok)">${money(total)}</b></div>
    <div style="display:flex;gap:4px;margin-top:8px">
      <button class="${selectedPay === 'نقدي' ? 'ok' : 'secondary'}" style="flex:1;padding:6px;font-size:11px" onclick="selectedPay='نقدي';render()">نقدي</button>
      <button class="${selectedPay === 'شبكة' ? 'ok' : 'secondary'}" style="flex:1;padding:6px;font-size:11px" onclick="selectedPay='شبكة';render()">شبكة</button>
      <button class="${selectedPay === 'تطبيق' ? 'ok' : 'secondary'}" style="flex:1;padding:6px;font-size:11px" onclick="selectedPay='تطبيق';render()">تطبيق دفع</button>
      <button class="${selectedPay === 'آجل' ? 'ok' : 'secondary'}" style="flex:1;padding:6px;font-size:11px" onclick="selectedPay='آجل';render()">آجل / ذمم</button>
    </div>
    <div style="display:flex;gap:6px;margin-top:8px">
      <button class="secondary" style="flex:1;padding:10px;font-size:12px" onclick="sendToKitchenOnly()">👨‍🍳 إرسال للمطبخ فقط</button>
      <button class="primary" style="flex:1;padding:10px;font-size:13px" onclick="completeSale()">✓ إتمام الدفع والطباعة</button>
    </div>
  </div>`;
}

function resetCart() {
  cart = [];
  activeTable = null;
  deliveryOrderNo = '';
  deliveryCaptain = '';
}

function addCart(id) {
  let p = db.products.find(x => x.id === id);
  if (!p) return;
  if (p.stock <= 0) return toast('المنتج نفد من المخزون');
  let x = cart.find(i => i.id === id);
  if (x) { if (x.qty + 1 > p.stock) return toast('الكمية تتجاوز المخزون'); x.qty++; }
  else cart.push({ id, qty: 1 });
  render();
}

function setQty(id, v) {
  let x = cart.find(i => i.id === id);
  let p = db.products.find(y => y.id === id);
  if (!x || !p) return;
  x.qty = Math.max(1, Math.min(Number(v) || 1, p.stock));
  render();
}

// إرسال الطلب للمطبخ فقط بدون دفع
function sendToKitchenOnly() {
  if (!cart.length) return toast('السلة فارغة');
  pushToKitchen();
  toast('تم إرسال الطلب للمطبخ بنجاح');
  resetCart();
  render();
}

function pushToKitchen() {
  let orderName = activeTable ? activeTable.name : (orderType === 'توصيل' ? `توصيل (${deliveryApp} ${deliveryOrderNo ? '#' + deliveryOrderNo : ''})` : 'طلب سفري');
  
  let kdsItem = {
    id: uid(),
    orderName: orderName,
    type: orderType,
    time: new Date().toLocaleTimeString('ar-SA'),
    items: [...cart]
  };

  db.kds.push(kdsItem);

  if (activeTable) {
    let t = db.tables.find(x => x.id === activeTable.id);
    if (t) {
      t.status = 'busy';
      t.order = { items: [...cart] };
    }
  }
  save();
}

// ----------------- شاشة المطبخ (KDS) -----------------
function kdsPage() {
  return shell(`<div style="flex:1;display:flex;flex-direction:column;overflow:hidden">
    <div class="row" style="margin-bottom:10px">
      <span style="color:var(--muted);font-size:12px">شاشة المطبخ تتحدث لحظياً وتصدر تنبيهات صوتية صاخبة عند وصول أي طلب جديد حتى يتم قبوله.</span>
      <button class="secondary" onclick="db.kds=[];stopAlarm();save();render()">إيقاف الإنذار ومسح الكل</button>
    </div>
    <div class="kds-grid">
      ${db.kds.length ? db.kds.map((o, idx) => `<div class="kds-card" style="border:2px solid var(--warn)">
        <div style="display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:6px">
          <b>${esc(o.orderName)}</b>
          <span style="font-size:11px;color:var(--warn)">${o.time}</span>
        </div>
        <div style="flex:1;overflow-y:auto;max-height:180px">
          ${o.items.map(i => {
            let p = db.products.find(x => x.id === i.id);
            return `<div style="display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px dashed var(--line);font-size:13px">
              <span>${esc(p ? p.name : 'منتج')}</span>
              <b style="color:var(--primary)">× ${i.qty}</b>
            </div>`;
          }).join('')}
        </div>
        <button class="ok" style="width:100%;padding:8px;font-size:13px" onclick="acceptKdsOrder(${idx})">✓ قبول الطلب وبدء التجهيز</button>
      </div>`).join('') : '<div class="empty" style="grid-column:1/-1">لا توجد طلبات معلقة في المطبخ حالياً</div>'}
    </div>
  </div>`, 'شاشة المطبخ (Kitchen Display System)');
}

function acceptKdsOrder(idx) {
  db.kds.splice(idx, 1);
  if (db.kds.length === 0) stopAlarm();
  save();
  render();
  toast('تم قبول الطلب وإيقاف الإنذار');
}

// ----------------- إتمام البيع -----------------
function completeSale() {
  if (!cart.length) return toast('السلة فارغة');
  let net = sum(cart, x => { let p = db.products.find(y => y.id === x.id); return p ? (p.price * x.qty) : 0; });
  let vat = net * db.business.vatRate / 100, total = net + vat;
  let orderName = activeTable ? activeTable.name : (orderType === 'توصيل' ? `توصيل (${deliveryApp} ${deliveryOrderNo ? '#' + deliveryOrderNo : ''})` : 'سفري');

  let s = { 
    id: uid(), 
    no: String(++db.lastInvoice), 
    date: new Date().toISOString(), 
    type: orderType, 
    customerName: orderName, 
    deliveryApp: orderType === 'توصيل' ? deliveryApp : '',
    deliveryOrderNo: deliveryOrderNo,
    deliveryCaptain: deliveryCaptain,
    payment: selectedPay, 
    net, vat, total, 
    cashier: db.business.cashier, 
    items: cart.map(x => { let p = db.products.find(y => y.id === x.id); return { id: p.id, name: p.name, qty: x.qty, price: Number(p.price) }; }) 
  };
  
  db.sales.push(s);

  // إذا كان طلب توصيل عبر تطبيق، نسجل المبلغ كذمم دائنة معلقة على التطبيق حتى يتم تحويلها للمطعم
  if (orderType === 'توصيل') {
    db.deliveries.push({
      id: uid(),
      date: new Date().toISOString(),
      app: deliveryApp,
      orderNo: deliveryOrderNo || s.no,
      amount: total,
      status: 'معلق (بانتظار التحويل)',
      settledDate: ''
    });
  }

  cart.forEach(x => { let p = db.products.find(y => y.id === x.id); if (p) p.stock -= x.qty; });

  // إرسال تلقائي للمطبخ عند الدفع
  pushToKitchen();

  if (activeTable) {
    let t = db.tables.find(x => x.id === activeTable.id);
    if (t) { t.status = 'empty'; t.order = null; }
  }

  save(); 
  resetCart(); 
  toast('تمت العملية بنجاح: ' + s.no); 
  printInvoice(s.id); 
  render();
}

// ----------------- قسم الحسابات والمالية المطور -----------------
function accountsPage() {
  let totalSales = sum(db.sales, x => x.total);
  let totalExpenses = sum(db.expenses, x => x.amount);
  let netProfit = totalSales - totalExpenses;
  let pendingDeliveries = sum(db.deliveries.filter(d => d.status.includes('معلق')), x => x.amount);

  return shell(`<div class="grid">
    <div class="card stat"><div class="label">إجمالي الإيرادات النقدية</div><div class="num" style="color:var(--ok)">${money(totalSales)}</div></div>
    <div class="card stat"><div class="label">إجمالي المصروفات التشغيلية</div><div class="num" style="color:var(--danger)">${money(totalExpenses)}</div></div>
    <div class="card stat"><div class="label">صافي الربح التقديري</div><div class="num" style="color:var(--primary)">${money(netProfit)}</div></div>
    <div class="card stat"><div class="label">مستحقات معلقة لدى التطبيقات</div><div class="num" style="color:var(--warn)">${money(pendingDeliveries)}</div></div>
  </div>
  <div class="card" style="margin-top:12px">
    <div class="row" style="margin-bottom:10px">
      <h3>تسجيل مصروف جديد (إيجار، رواتب، مواد خام...)</h3>
      <button class="primary" onclick="addExpensePrompt()">+ إضافة مصروف</button>
    </div>
    ${expensesTable(db.expenses)}
  </div>`, 'قسم الحسابات والمالية المطور');
}

function addExpensePrompt() {
  let title = prompt('بيان المصروف (مثلاً: شراء خضار، فاتورة كهرباء، رواتب):');
  if (!title) return;
  let amount = Number(prompt('المبلغ بالريال:') || 0);
  if (amount <= 0) return toast('مبلغ غير صحيح');
  
  db.expenses.push({
    id: uid(),
    date: new Date().toISOString(),
    title: title.trim(),
    amount: amount
  });
  save(); render(); toast('تم تسجيل المصروف بنجاح');
}

function expensesTable(a) {
  if (!a.length) return '<div class="empty">لا توجد مصروفات مسجلة</div>';
  return `<div class="table-wrap"><table><tr><th>التاريخ</th><th>البيان</th><th>المبلغ</th><th>تحكم</th></tr>${a.map((e, idx) => `<tr><td>${new Date(e.date).toLocaleDateString('ar-SA')}</td><td><b>${esc(e.title)}</b></td><td style="color:var(--danger)">${money(e.amount)}</td><td><button class="danger" style="padding:2px 6px;font-size:10px" onclick="db.expenses.splice(${idx},1);save();render()">حذف</button></td></tr>`).join('')}</table></div>`;
}

// ----------------- تسويات ومبالغ تطبيقات التوصيل -----------------
function deliveriesPage() {
  return shell(`<div class="card">
    <div class="row" style="margin-bottom:10px">
      <h3>متابعة مستحقات تطبيقات التوصيل (جاهز، هنقرستيشن، تويو، مرسول)</h3>
      <span style="font-size:12px;color:var(--muted)">تتبع متى يقوم التطبيق بتحويل مستحقات المطعم المالية.</span>
    </div>
    ${deliveriesTable(db.deliveries)}
  </div>`, 'تسويات ومبالغ تطبيقات التوصيل');
}

function deliveriesTable(a) {
  if (!a.length) return '<div class="empty">لا توجد طلبات توصيل مسجلة عبر التطبيقات بعد</div>';
  return `<div class="table-wrap"><table><tr><th>التاريخ</th><th>التطبيق</th><th>رقم الطلب</th><th>المبلغ</th><th>الحالة</th><th>إجراء</th></tr>${a.map((d, idx) => `<tr>
    <td>${new Date(d.date).toLocaleDateString('ar-SA')}</td>
    <td><b>${esc(d.app)}</b></td>
    <td>${esc(d.orderNo)}</td>
    <td style="color:var(--ok)">${money(d.amount)}</td>
    <td><span class="badge" style="background:${d.status.includes('تم') ? 'rgba(16,185,129,0.2)' : 'rgba(245,158,11,0.2)'};color:${d.status.includes('تم') ? 'var(--ok)' : 'var(--warn)'}">${esc(d.status)}</span></td>
    <td>${d.status.includes('معلق') ? `<button class="ok" style="padding:4px 8px;font-size:11px" onclick="settleDelivery(${idx})">تحديد كـ "تم التحويل للمطعم"</button>` : '<span style="font-size:11px;color:var(--muted)">تمت التسوية</span>'}</td>
  </tr>`).join('')}</table></div>`;
}

function settleDelivery(idx) {
  db.deliveries[idx].status = 'تم التحويل للمطعم';
  db.deliveries[idx].settledDate = new Date().toISOString();
  save(); render();
  toast('تم تحديث حالة استلام المبلغ من التطبيق');
}

// ----------------- التقارير والأرباح واللوحة -----------------
function dashboard() {
  let sales = sum(db.sales, x => x.total);
  let expenses = sum(db.expenses, x => x.amount);
  let low = db.products.filter(p => p.stock <= db.settings.lowStock).length;
  return shell(`<div class="grid">
    <div class="card stat"><div class="label">إجمالي المبيعات</div><div class="num" style="color:var(--ok)">${money(sales)}</div></div>
    <div class="card stat"><div class="label">إجمالي المصروفات</div><div class="num" style="color:var(--danger)">${money(expenses)}</div></div>
    <div class="card stat"><div class="label">صافي الربح</div><div class="num" style="color:var(--primary)">${money(sales - expenses)}</div></div>
    <div class="card stat"><div class="label">تنبيهات المخزون</div><div class="num" style="color:var(--danger)">${low}</div></div>
  </div><div class="card" style="margin-top:12px"><h3>آخر الفواتير المسجلة</h3>${salesTable(db.sales.slice().reverse().slice(0, 10))}</div>`, 'لوحة التقارير والأرباح');
}

function salesTable(a) {
  if (!a.length) return '<div class="empty">لا توجد فواتير</div>';
  return `<div class="table-wrap"><table><tr><th>الرقم</th><th>التاريخ</th><th>النوع / الوجهة</th><th>الدفع</th><th>الإجمالي</th><th>إجراء</th></tr>${a.map(s => `<tr><td>${esc(s.no)}</td><td>${new Date(s.date).toLocaleString('ar-SA')}</td><td>${esc(s.customerName)}</td><td>${esc(s.payment)}</td><td>${money(s.total)}</td><td><button class="secondary" style="padding:4px 8px;font-size:11px" onclick="printInvoice('${s.id}')">طباعة</button></td></tr>`).join('')}</table></div>`;
}

function productsPage() {
  return shell(`<div class="card"><div class="row"><button class="primary" onclick="productModal()">+ إضافة منتج جديد</button><input placeholder="بحث..." oninput="filterProds(this.value)"></div><div id="pList" style="margin-top:10px">${prodsTable(db.products)}</div></div>`, 'إدارة المنتجات');
}

function prodsTable(a) {
  if (!a.length) return '<div class="empty">لا توجد منتجات مضافة بعد</div>';
  return `<div class="table-wrap"><table><tr><th>الاسم</th><th>التصنيف</th><th>السعر</th><th>التكلفة</th><th>المخزون</th><th>تحكم</th></tr>${a.map(p => `<tr><td><b>${esc(p.name)}</b></td><td><span class="badge">${esc(p.category || 'وجبات')}</span></td><td>${money(p.price)}</td><td>${money(p.cost)}</td><td>${p.stock}</td><td><button class="secondary" style="padding:4px 8px;font-size:11px" onclick="productModal('${p.id}')">تعديل</button></td></tr>`).join('')}</table></div>`;
}

function filterProds(q) {
  let arr = db.products.filter(p => p.name.toLowerCase().includes(q.toLowerCase()) || (p.category || '').toLowerCase().includes(q.toLowerCase()));
  let el = $('pList'); if (el) el.innerHTML = prodsTable(arr);
}

function productModal(id) {
  let p = db.products.find(x => x.id === id) || { name: '', category: 'وجبات', barcode: '', price: 0, cost: 0, stock: 100 };
  let m = document.createElement('div');
  m.id = 'modal'; m.className = 'overlay';
  m.innerHTML = `<div class="modal"><h2>${id ? 'تعديل منتج' : 'منتج جديد'}</h2><div class="grid3">${mfield('pn', 'اسم الوجبة / المنتج', p.name)}${mfield('pcateg', 'التصنيف', p.category)}${mfield('pb', 'الباركود', p.barcode)}${mfield('pp', 'سعر البيع', p.price, 'number')}${mfield('pco', 'التكلفة', p.cost, 'number')}${mfield('ps', 'المخزون', p.stock, 'number')}</div><button class="primary" style="margin-top:12px" onclick="saveProduct('${id || ''}')">حفظ المنتج</button> <button class="secondary" onclick="closeModal()">إلغاء</button></div>`;
  document.body.appendChild(m);
}
function mfield(id, l, v, t = 'text') { return `<div class="field"><label>${l}</label><input id="${id}" type="${t}" value="${esc(v)}"></div>`; }
function saveProduct(id) {
  let name = $('pn').value.trim();
  if (!name) return toast('اسم المنتج مطلوب');
  let p = id ? db.products.find(x => x.id === id) : { id: uid() };
  p.name = name;
  p.category = $('pcateg').value.trim() || 'وجبات';
  p.barcode = $('pb').value.trim();
  p.price = Number($('pp').value || 0);
  p.cost = Number($('pco').value || 0);
  p.stock = Number($('ps').value || 0);
  if (!id) db.products.push(p);
  save(); closeModal(); render(); toast('تم الحفظ');
}

function salesPage() {
  return shell(`<div class="card"><div class="row"><input placeholder="بحث برقم الفاتورة..." oninput="filterSales(this.value)"></div><div id="salesList" style="margin-top:10px">${salesTable(db.sales.slice().reverse())}</div></div>`, 'فواتير المبيعات');
}
function filterSales(q) {
  let arr = db.sales.filter(s => s.no.includes(q) || s.customerName.includes(q));
  let el = $('salesList'); if (el) el.innerHTML = salesTable(arr.slice().reverse());
}

function settingsPage() {
  return shell(`<div class="card"><div class="title" style="font-weight:bold;margin-bottom:10px">الإعدادات العامة</div><div class="grid2">${['name', 'activity', 'vat', 'cr', 'phone', 'address', 'city', 'branch'].map(k => mfield('s_' + k, k, db.business[k] || '')).join('')}</div><button class="primary" style="margin-top:10px" onclick="saveSettings()">حفظ التعديلات</button></div>`, 'الإعدادات');
}
function saveSettings() {
  ['name', 'activity', 'vat', 'cr', 'phone', 'address', 'city', 'branch'].forEach(k => { let el = $('s_' + k); if (el) db.business[k] = el.value.trim(); });
  save(); render(); toast('تم حفظ الإعدادات');
}

function closeModal() { let m = $('modal'); if (m) m.remove(); }
function qrTLV(s) {
  const vals = [db.business.name, db.business.vat, s.date, s.total.toFixed(2), s.vat.toFixed(2)], out = [];
  const e = new TextEncoder();
  vals.forEach((v, i) => { let b = e.encode(String(v)); out.push(i + 1, b.length, ...b); });
  return btoa(String.fromCharCode(...out));
}
function invoiceHtml(s) {
  return `<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><title>فاتورة ${s.no}</title><style>body{font-family:Tahoma;padding:20px;color:#111}.wrap{max-width:400px;margin:auto;text-align:center}.head{border-bottom:1px dashed #333;padding-bottom:10px;margin-bottom:10px}table{width:100%;border-collapse:collapse;font-size:12px}th,td{padding:4px;text-align:right;border-bottom:1px solid #ddd}</style></head><body><div class="wrap"><div class="head"><h3>${esc(db.business.name)}</h3><div>رقم الفاتورة: ${s.no}</div><div>النوع: ${esc(s.customerName)}</div><div>التاريخ: ${new Date(s.date).toLocaleString('ar-SA')}</div></div><table><tr><th>الصنف</th><th>كمية</th><th>السعر</th></tr>${s.items.map(i => `<tr><td>${esc(i.name)}</td><td>${i.qty}</td><td>${money(i.price * i.qty)}</td></tr>`).join('')}</table><div style="margin-top:10px;text-align:left;font-size:13px"><b>الإجمالي: ${money(s.total)}</b></div></div><script>setTimeout(()=>window.print(),300)<\/script></body></html>`;
}
function printInvoice(id) {
  let s = db.sales.find(x => x.id === id); if (!s) return;
  let w = window.open('', '_blank'); w.document.write(invoiceHtml(s)); w.document.close();
}

function render() {
  let root = $('root'); if (!root) return;
  if (!db.setup) { root.innerHTML = setup(); return; }
  let html = '';
  if (page === 'pos') html = posPage();
  else if (page === 'tables') html = tablesPage();
  else if (page === 'kds') html = kdsPage();
  else if (page === 'accounts') html = accountsPage();
  else if (page === 'deliveries') html = deliveriesPage();
  else if (page === 'dashboard') html = dashboard();
  else if (page === 'sales') html = salesPage();
  else if (page === 'products') html = productsPage();
  else if (page === 'settings') html = settingsPage();
  root.innerHTML = html;
}

render();
</script>
</body>
</html>
